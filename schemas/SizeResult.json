{
  "$defs": {
    "BenchmarkMetric": {
      "enum": [
        "decode_tps",
        "prefill_tps",
        "aggregate_tps",
        "ttft_s",
        "aa_index_v5",
        "terminal_bench",
        "swe_bench"
      ],
      "title": "BenchmarkMetric",
      "type": "string"
    },
    "FormulaTrace": {
      "additionalProperties": false,
      "description": "Symbolic and substituted formula for the audit drawer (Req 36.1).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "result": {
          "title": "Result",
          "type": "number"
        },
        "substituted": {
          "title": "Substituted",
          "type": "string"
        },
        "symbolic": {
          "title": "Symbolic",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "name",
        "symbolic",
        "substituted",
        "result",
        "unit"
      ],
      "title": "FormulaTrace",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "A computed number with its Value_Origin.",
      "properties": {
        "origin": {
          "$ref": "#/$defs/ValueOrigin"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit",
        "origin"
      ],
      "title": "Metric",
      "type": "object"
    },
    "PerformanceResult": {
      "additionalProperties": false,
      "properties": {
        "decode_tps": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_tps": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ]
        },
        "prefill_1m_minutes": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prefill_tps": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ]
        },
        "traces": {
          "items": {
            "$ref": "#/$defs/FormulaTrace"
          },
          "title": "Traces",
          "type": "array"
        },
        "ttft_s": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "decode_tps",
        "prefill_tps",
        "ttft_s",
        "effective_tps",
        "warnings",
        "traces"
      ],
      "title": "PerformanceResult",
      "type": "object"
    },
    "PrecisionFormat": {
      "enum": [
        "FP16",
        "BF16",
        "FP8",
        "INT8",
        "INT4",
        "INT3",
        "INT2"
      ],
      "title": "PrecisionFormat",
      "type": "string"
    },
    "QualityScore": {
      "additionalProperties": false,
      "properties": {
        "benchmark": {
          "$ref": "#/$defs/BenchmarkMetric"
        },
        "fallback_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fallback Note"
        },
        "origin": {
          "$ref": "#/$defs/ValueOrigin"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "benchmark",
        "origin",
        "fallback_note"
      ],
      "title": "QualityScore",
      "type": "object"
    },
    "SizingResult": {
      "additionalProperties": false,
      "properties": {
        "agent_state_memory_required_gb": {
          "title": "Agent State Memory Required Gb",
          "type": "number"
        },
        "alpha_scaling": {
          "title": "Alpha Scaling",
          "type": "number"
        },
        "context_eviction_risk": {
          "default": false,
          "title": "Context Eviction Risk",
          "type": "boolean"
        },
        "eu_commercial_license_valid": {
          "default": true,
          "title": "Eu Commercial License Valid",
          "type": "boolean"
        },
        "hardware_id": {
          "title": "Hardware Id",
          "type": "string"
        },
        "is_feasible": {
          "title": "Is Feasible",
          "type": "boolean"
        },
        "kv_per_token_bytes": {
          "title": "Kv Per Token Bytes",
          "type": "number"
        },
        "kv_pool_gb": {
          "title": "Kv Pool Gb",
          "type": "number"
        },
        "m_kv_single_gb": {
          "title": "M Kv Single Gb",
          "type": "number"
        },
        "max_concurrent_users": {
          "title": "Max Concurrent Users",
          "type": "integer"
        },
        "max_usable_context": {
          "title": "Max Usable Context",
          "type": "integer"
        },
        "meets_128k_agentic_context_floor": {
          "default": true,
          "title": "Meets 128K Agentic Context Floor",
          "type": "boolean"
        },
        "memory_breakdown": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Memory Breakdown",
          "type": "array"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "nodes_required": {
          "title": "Nodes Required",
          "type": "integer"
        },
        "oom_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oom Reason"
        },
        "precision": {
          "$ref": "#/$defs/PrecisionFormat"
        },
        "requested_nodes": {
          "title": "Requested Nodes",
          "type": "integer"
        },
        "thunderbolt_mesh_cables": {
          "default": 0,
          "title": "Thunderbolt Mesh Cables",
          "type": "integer"
        },
        "token_agreement_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Agreement Rate"
        },
        "traces": {
          "items": {
            "$ref": "#/$defs/FormulaTrace"
          },
          "title": "Traces",
          "type": "array"
        },
        "triggered_mac_default_split_trap": {
          "default": false,
          "title": "Triggered Mac Default Split Trap",
          "type": "boolean"
        },
        "usable_memory_default_gb": {
          "title": "Usable Memory Default Gb",
          "type": "number"
        },
        "usable_memory_gb": {
          "title": "Usable Memory Gb",
          "type": "number"
        },
        "usable_system_ram_gb": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Usable System Ram Gb"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "weights": {
          "$ref": "#/$defs/Metric"
        }
      },
      "required": [
        "hardware_id",
        "model_id",
        "precision",
        "requested_nodes",
        "nodes_required",
        "alpha_scaling",
        "is_feasible",
        "usable_memory_gb",
        "usable_memory_default_gb",
        "usable_system_ram_gb",
        "weights",
        "kv_per_token_bytes",
        "m_kv_single_gb",
        "kv_pool_gb",
        "max_concurrent_users",
        "max_usable_context",
        "agent_state_memory_required_gb",
        "memory_breakdown",
        "warnings",
        "traces"
      ],
      "title": "SizingResult",
      "type": "object"
    },
    "ValueOrigin": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "enum": [
            "measured",
            "formula"
          ],
          "title": "Origin",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "origin",
        "source_ids"
      ],
      "title": "ValueOrigin",
      "type": "object"
    },
    "WorkloadResult": {
      "additionalProperties": false,
      "properties": {
        "kappa_mega": {
          "title": "Kappa Mega",
          "type": "number"
        },
        "monthly_output_demand": {
          "title": "Monthly Output Demand",
          "type": "number"
        },
        "monthly_requests": {
          "title": "Monthly Requests",
          "type": "integer"
        },
        "monthly_tokens": {
          "title": "Monthly Tokens",
          "type": "number"
        },
        "nu_verify": {
          "title": "Nu Verify",
          "type": "number"
        },
        "out_think": {
          "title": "Out Think",
          "type": "number"
        },
        "s_effective": {
          "title": "S Effective",
          "type": "number"
        },
        "t_in_hat": {
          "title": "T In Hat",
          "type": "number"
        },
        "t_out_hat": {
          "title": "T Out Hat",
          "type": "number"
        },
        "tau": {
          "title": "Tau",
          "type": "number"
        }
      },
      "required": [
        "monthly_requests",
        "s_effective",
        "t_in_hat",
        "t_out_hat",
        "out_think",
        "kappa_mega",
        "nu_verify",
        "tau",
        "monthly_tokens",
        "monthly_output_demand"
      ],
      "title": "WorkloadResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aa_index_v5": {
      "anyOf": [
        {
          "$ref": "#/$defs/QualityScore"
        },
        {
          "type": "null"
        }
      ]
    },
    "performance": {
      "anyOf": [
        {
          "$ref": "#/$defs/PerformanceResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "sizing": {
      "$ref": "#/$defs/SizingResult"
    },
    "workload": {
      "$ref": "#/$defs/WorkloadResult"
    }
  },
  "required": [
    "sizing",
    "performance",
    "workload",
    "aa_index_v5"
  ],
  "title": "SizeResult",
  "type": "object"
}
