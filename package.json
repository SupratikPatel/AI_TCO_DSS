{
  "name": "ai-tco-dss-workspace",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "npm run typecheck -w frontend",
    "lint": "npm run lint -w frontend",
    "build": "npm run build -w frontend",
    "test": "npm run test -w frontend",
    "test:browser": "playwright test --config frontend/playwright.config.ts",
    "test:launcher": "node --test --test-concurrency=1 scripts/dev.test.mjs scripts/production.test.mjs",
    "types:generate": "node scripts/api-types.mjs",
    "types:check": "node scripts/api-types.mjs --check",
    "start": "uv run uvicorn ai_tco_dss.api.production:create_app --factory --host 127.0.0.1 --port 8000"
  }
}
